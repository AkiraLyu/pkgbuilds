# Maintainer: Akira <akira.uestc@gmail.com>
pkgname=adjustable-task-manager
pkgver=0.1.0
pkgrel=1
pkgdesc='Plasma task manager with adjustable launcher spacing and task width'
arch=('x86_64')
url='https://github.com/AkiraLyu/kde-plugins'
license=('GPL-2.0-or-later' 'LGPL-2.0-or-later')
depends=(plasma-desktop plasma-workspace libplasma plasma-activities plasma-activities-stats
         libksysguard qt6-declarative kconfig ki18n kio knotifications kservice kwindowsystem)
makedepends=(git cmake ninja extra-cmake-modules gettext)
options=('!debug' '!lto')
_commit=ae504529368004bd468973627fc5fa1f6e6089bb
source=("kde-plugins::git+$url.git#commit=$_commit")
sha256sums=('SKIP')

build() {
    cmake -S "$srcdir/kde-plugins/adjustable-task-manager" -B "$srcdir/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=None -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib \
        -DKDE_INSTALL_PLUGINDIR=lib/qt6/plugins -DBUILD_TESTING=ON
    cmake --build "$srcdir/build" --parallel 2
}

check() {
    ctest --test-dir "$srcdir/build" --output-on-failure
}

package() {
    DESTDIR="$pkgdir" cmake --install "$srcdir/build"
}
