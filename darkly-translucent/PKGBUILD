pkgname=darkly-translucent
pkgver=0.5.42
pkgrel=1
pkgdesc='Darkly Plasma theme with translucent backgrounds'
arch=('any')
url='https://github.com/AkiraLyu/kde-plugins'
license=('GPL-2.0-only')
depends=(plasma-workspace)
makedepends=(git )
options=('!debug' '!lto')
_commit=97651b3f18eff86611663ce737c545d114ece9ac
source=("kde-plugins::git+$url.git#commit=$_commit")
sha256sums=('SKIP')

package() {
    install -d "$pkgdir/usr/share/plasma/desktoptheme/darkly-translucent"
    cp -r "$srcdir/kde-plugins/darkly-translucent/." "$pkgdir/usr/share/plasma/desktoptheme/darkly-translucent/"
}
