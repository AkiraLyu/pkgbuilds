pkgbase = focus-git
	pkgdesc = A GTK4 and libadwaita focus app for Linux with Pomodoro timers, long-term tasks, Markdown notes, and focus statistics, with all data stored locally.
	pkgver = 0.1.0.r12.gad4a8d3
	pkgrel = 1
	url = https://github.com/AkiraLyu/focus
	arch = x86_64
	license = MIT
	makedepends = cmake
	makedepends = git
	makedepends = ninja
	makedepends = pkgconf
	depends = cmark-gfm
	depends = gcc-libs
	depends = glib2
	depends = gtk4>=4.16
	depends = hicolor-icon-theme
	depends = libadwaita>=1.6
	depends = libcanberra
	depends = libdbusmenu-glib
	depends = sound-theme-freedesktop
	depends = sqlite
	provides = focus
	conflicts = focus
	options = !debug
	options = strip
	source = focus-git::git+https://github.com/AkiraLyu/focus.git
	sha256sums = SKIP

pkgname = focus-git
