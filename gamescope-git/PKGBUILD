# Maintainer: Akira <akira.uestc@gmail.com>
pkgname=gamescope-git
pkgver=3.16.24.r23.gaa77068
pkgrel=2
pkgdesc='Gamescope with personal Anime4K filters'
arch=('x86_64')
url='https://github.com/AkiraLyu/gamescope'
license=('BSD-2-Clause' 'BSD-3-Clause' 'LicenseRef-Reshade')
depends=(glibc gcc-libs libavif libcap libdecor libdrm libei libinput libpipewire
         libx11 libxcb libxcomposite libxcursor libxdamage libxext libxfixes libxi
         libxkbcommon libxmu libxrender libxres libxtst libxxf86vm luajit pixman
         sdl2 seatd systemd-libs vulkan-icd-loader wayland xcb-util-errors
         xcb-util-wm xorg-xwayland)
makedepends=(git meson ninja cmake glslang vulkan-headers wayland-protocols
             xorgproto hwdata python)
provides=(gamescope)
conflicts=(gamescope)
options=('!debug' '!lto')
source=("gamescope::git+$url.git")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/gamescope"
    git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
    cd "$srcdir/gamescope"
    git submodule update --init --recursive --depth 1
}

build() {
    arch-meson "$srcdir/gamescope" "$srcdir/build" -Dbenchmark=disabled
    meson compile -C "$srcdir/build" -j 2
}

check() {
    meson test -C "$srcdir/build" --print-errorlogs
}

package() {
    DESTDIR="$pkgdir" meson install -C "$srcdir/build"
    install -Dm644 "$srcdir/gamescope/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "$srcdir/gamescope/src/reshade/LICENSE.md" "$pkgdir/usr/share/licenses/$pkgname/Reshade-LICENSE.md"
}
