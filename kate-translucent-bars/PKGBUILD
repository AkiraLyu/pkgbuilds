# Maintainer: Akira <akira.uestc@gmail.com>
pkgname=kate-translucent-bars
pkgver=1.2.0
pkgrel=1
pkgdesc='Translucent Kate toolbars and sidebars'
arch=('x86_64')
url='https://github.com/AkiraLyu/kde-plugins'
license=('GPL-2.0-or-later')
depends=(kate qt6-base kcoreaddons ktexteditor kwidgetsaddons kconfig bash)
makedepends=(git cmake ninja)
options=('!debug' '!lto')
_commit=ae504529368004bd468973627fc5fa1f6e6089bb
source=("kde-plugins::git+$url.git#commit=$_commit")
sha256sums=('SKIP')

build() {
    cmake -S "$srcdir/kde-plugins/kate-translucent-bars" -B "$srcdir/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=None -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib 
    cmake --build "$srcdir/build" --parallel 2
}

package() {
    DESTDIR="$pkgdir" cmake --install "$srcdir/build"
    install -Dm755 "$srcdir/kde-plugins/kate-translucent-bars/launch-kate" "$pkgdir/usr/bin/kate-translucent"
}
