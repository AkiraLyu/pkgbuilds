# Maintainer: Akira <akira.uestc@gmail.com>
pkgname=kde-config
pkgver=1.0.0
pkgrel=8
pkgdesc='Personal KDE appearance settings and theme controls'
arch=('any')
url='https://github.com/AkiraLyu/kde-plugins'
license=('LicenseRef-unknown')
depends=(appgrid adjustable-task-manager kate-translucent-bars wechat-glass-live darkly-translucent darkly-bin plasma6-themes-layan-git kwin-effect-rounded-corners-git kwin-effects-better-blur-dx kconfig qt6-tools glib2 bash systemd)
makedepends=(git)
options=('!debug' '!lto')
_commit=a9f1c5733cafb7e5f07ea9e87fc9fa1ac735fa08
source=("kde-plugins::git+$url.git#commit=$_commit")
sha256sums=('SKIP')

optdepends=('flatpak: configure the WeChat XWayland backend')

package() {
    cd "$srcdir/kde-plugins/kde-config"
    install -Dm755 apply-config "$pkgdir/usr/bin/kde-config"
    install -Dm755 darkly-theme "$pkgdir/usr/bin/darkly-theme"
    for file in kwinrc darklyrc kdeglobals org.kde.kate.desktop; do
        install -Dm644 "$file" "$pkgdir/usr/share/kde-config/$file"
    done
    install -Dm644 theme-toggle.desktop "$pkgdir/usr/share/applications/theme-toggle.desktop"
    install -Dm644 theme-sync.service "$pkgdir/usr/lib/systemd/user/theme-sync.service"
}
