# Maintainer: Akira <akira.lyu.cn@gmail.com>
# Contributor: cosmo <aur@dawnson.is>
# Contributor: FreeFull <jazz2rulez@gmail.com>
# Contributor: Julius Michaelis <gitter@liftm.de.de>
# Contributor: Nebulosa <nebulosa2007-at-yandex-dot-ru>
# Based on https://aur.archlinux.org/niri-git.git

pkgname=niri-akira-git
pkgver=26.4.0.r2944.g0fcdb57
pkgrel=1
pkgdesc='Scrollable-tiling Wayland compositor with popup shadows'
arch=('x86_64' 'aarch64')
url='https://github.com/AkiraLyu/niri'
license=('GPL-3.0-or-later')
depends=(bash cairo glib2 glibc libdisplay-info libgcc libinput libpipewire libxkbcommon
         mesa pango pixman seatd systemd-libs wayland)
makedepends=(clang git rust)
optdepends=(
    'fuzzel: application launcher'
    'waybar: status bar'
    'alacritty: terminal emulator'
    'mako: notification daemon'
    'swaybg: wallpaper utility'
    'swaylock: screen locker'
    'xwayland-satellite: X11 application support'
    'xdg-desktop-portal-gtk: basic desktop portals'
    'xdg-desktop-portal-gnome: screencasting support'
    'gnome-keyring: secret portal'
    'polkit-gnome: authentication agent'
)
provides=("niri=$pkgver" wayland-compositor)
conflicts=(niri niri-git niri-bin)
options=('!debug' '!lto' 'strip')
source=("niri::git+$url.git#branch=feat/popup-shadows")
b2sums=('SKIP')

# Prefer a smaller download over faster compression and decompression.
PKGEXT='.pkg.tar.xz'
COMPRESSXZ=(xz -c -z -9e -T1)

pkgver() {
    cd "$srcdir/niri"
    local version count commit
    version=$(awk -F '"' '/^version = / { print $2; exit }' Cargo.toml) || return 1
    [[ -n $version ]] || return 1
    count=$(git rev-list --count HEAD) || return 1
    commit=$(git rev-parse --short=7 HEAD) || return 1
    printf '%s.r%s.g%s\n' "$version" "$count" "$commit"
}

prepare() {
    cd "$srcdir/niri"
    export CARGO_HOME="$srcdir/.cargo"
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$srcdir/niri"
    export CARGO_HOME="$srcdir/.cargo"
    export CARGO_TARGET_DIR=target
    export CARGO_PROFILE_RELEASE_OPT_LEVEL=z
    export CARGO_PROFILE_RELEASE_LTO=fat
    export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1
    export CARGO_PROFILE_RELEASE_DEBUG=0
    export CARGO_PROFILE_RELEASE_STRIP=symbols
    export CARGO_PROFILE_RELEASE_PANIC=abort

    # Override makepkg's optimization level while preserving other user flags.
    export RUSTFLAGS="${RUSTFLAGS:+$RUSTFLAGS }-C opt-level=z"

    cargo build --frozen --release --bin niri
}

package() {
    cd "$srcdir/niri"
    install -Dm755 target/release/niri -t "$pkgdir/usr/bin/"
    install -Dm755 resources/niri-session -t "$pkgdir/usr/bin/"
    install -Dm644 resources/default-config.kdl -t "$pkgdir/usr/share/doc/niri/"
    install -Dm644 resources/niri.desktop -t "$pkgdir/usr/share/wayland-sessions/"
    install -Dm644 resources/niri-portals.conf -t "$pkgdir/usr/share/xdg-desktop-portal/"
    install -Dm644 resources/niri{.service,-shutdown.target} -t "$pkgdir/usr/lib/systemd/user/"
}
