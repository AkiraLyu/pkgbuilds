# Maintainer: Akira <akira.uestc@gmail.com>
pkgname=niri-meta
pkgver=1.0
pkgrel=2
pkgdesc="Meta package for the Niri desktop and Noctalia shell"
arch=('any')
license=('custom:none')

depends=(
    niri
    xwayland-satellite
    network-manager-applet
    rofi
    noctalia-qs
    noctalia-shell
    gpu-screen-recorder
)

package() {
    mkdir -p "$pkgdir/usr/share/doc/$pkgname"
    printf '%s\n' "$pkgdesc" > "$pkgdir/usr/share/doc/$pkgname/README"
}
