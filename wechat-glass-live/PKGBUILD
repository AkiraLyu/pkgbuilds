# Maintainer: Akira <akira.uestc@gmail.com>
pkgname=wechat-glass-live
pkgver=0.6.1
pkgrel=1
pkgdesc='KWin effect for translucent WeChat bars on XWayland and Wayland'
arch=('x86_64')
url='https://github.com/AkiraLyu/kde-plugins'
license=('GPL-2.0-or-later')
depends=(kwin qt6-base qt6-declarative libxcb python qt6-tools kconfig kwin-effects-better-blur-dx)
makedepends=(git cmake ninja extra-cmake-modules vulkan-headers)
options=('!debug' '!lto')
_commit=e5c28f8d37921e709d7149424b917a1748d40a6e
source=("kde-plugins::git+$url.git#commit=$_commit")
sha256sums=('SKIP')

build() {
    cmake -S "$srcdir/kde-plugins/wechat-glass-live" -B "$srcdir/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=None -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib 
    cmake --build "$srcdir/build" --parallel 2
}

package() {
    DESTDIR="$pkgdir" cmake --install "$srcdir/build"
    install -Dm755 "$srcdir/kde-plugins/wechat-glass-live/control.py" "$pkgdir/usr/bin/wechat-glass-control"
}
