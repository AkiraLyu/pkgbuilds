# Maintainer: shtrophic <aur at shtrophic dot net>
# Contributor: Nebulosa <nebulosa2007-at-yandex-dot-ru>

_pkgname=xwayland-satellite
pkgname="$_pkgname-akira"
pkgver=0.8.2.r18.gae88928
pkgrel=1
pkgdesc="Xwayland outside your Wayland - git version with fixes"
arch=(x86_64)
url="https://github.com/AkiraLyu/$_pkgname"
license=(MPL-2.0)
depends=(
	gcc-libs
	glibc
	libxcb
	xcb-util-cursor
	xorg-xwayland
)
makedepends=(
	git
	clang
	rust
)
provides=($_pkgname)
conflicts=($_pkgname)
source=(git+$url.git)
b2sums=('SKIP')

pkgver() {
	cd "$srcdir/$_pkgname" || return 1
	local version count commit
	version=$(awk -F '"' '/^version = / { print $2; exit }' Cargo.toml) || return 1
	[[ -n $version ]] || return 1
	count=$(git rev-list --count HEAD) || return 1
	commit=$(git rev-parse --short=7 HEAD) || return 1
	printf '%s.r%s.g%s\n' "$version" "$count" "$commit"
}

prepare() {
	cd $_pkgname
	export RUSTUP_TOOLCHAIN=stable
	export CARGO_HOME="$srcdir"/.cargo
	sed 's|/usr/local|/usr|' -i resources/$_pkgname.service
	cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
	cd $_pkgname
	export RUSTUP_TOOLCHAIN=stable
	export CARGO_HOME="$srcdir"/.cargo
	export RUSTFLAGS="--remap-path-prefix=$srcdir=/"
	export CARGO_TARGET_DIR=target
	cargo build --frozen --release --features systemd
}

check() {
	cd $_pkgname
	export XDG_RUNTIME_DIR="$(mktemp -d)"
	export RUSTUP_TOOLCHAIN=stable
	cargo test --frozen -- --test-threads 1
}

package() {
	install -Dm644 $_pkgname/resources/$_pkgname.service -t "$pkgdir"/usr/lib/systemd/user/
	install -Dm755 $_pkgname/target/release/$_pkgname -t "$pkgdir"/usr/bin/
}
